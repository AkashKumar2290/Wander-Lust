
<!-- SUCCESS -->

<% if(success && success.length){ %>

<div
    class="alert alert-dismissible fade show premium-alert premium-success"
    role="alert"
>
    <i class="fa-solid fa-circle-check"></i>

    <span class="flash-message">
        <%= success %>
    </span>

    <button
        type="button"
        class="btn-close"
        data-bs-dismiss="alert"
        aria-label="Close"
    ></button>
</div>

<% } %>


<!-- ERROR -->

<% if(error && error.length){ %>

<div
    class="alert alert-dismissible fade show premium-alert premium-error"
    role="alert"
>
    <i class="fa-solid fa-circle-exclamation"></i>

    <span class="flash-message">
        <%= error %>
    </span>

    <button
        type="button"
        class="btn-close"
        data-bs-dismiss="alert"
        aria-label="Close"
    ></button>
</div>

<% } %>