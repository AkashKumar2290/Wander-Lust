<% layout("layouts/boilerplate") %>

<div class="create-page">

    <div class="create-header">
        <h3>Create a New Listing</h3>
        <p>Share your place with travelers and let them discover something special.</p>
    </div>


    <div class="create-card">

        <form
            method="POST"
            action="/listings"
            novalidate
            class="needs-validation"
            enctype="multipart/form-data"
        >

            <!-- TITLE -->

            <div class="mb-4">

                <label for="title" class="form-label">
                    Listing Title
                </label>

                <input
                    name="listing[title]"
                    id="title"
                    placeholder="Add a catchy title"
                    type="text"
                    class="form-control"
                    required
                />

                <div class="valid-feedback">
                    Title Looks good!
                </div>

            </div>


            <!-- DESCRIPTION -->

            <div class="mb-4">

                <label for="description" class="form-label">
                    Description
                </label>

                <textarea
                    name="listing[description]"
                    id="description"
                    class="form-control"
                    placeholder="Tell guests what makes this place special..."
                    required
                ></textarea>

                <div class="invalid-feedback">
                    Please enter a short description
                </div>

            </div>


            <!-- IMAGE UPLOAD -->

            <div class="mb-3">

                <label for="image" class="form-label">
                    Upload Listing Image
                </label>

                <div class="image-upload-box">

                    <div class="mb-2">
                        <i class="fa-solid fa-cloud-arrow-up upload-icon"></i>
                        <strong>Upload an image</strong>
                    </div>

                    <input
                        name="image"
                        id="image"
                        type="file"
                        class="form-control"
                        accept="image/*"
                    />

                </div>

            </div>


            <!-- OR -->

            <div class="or-divider">
                OR
            </div>


            <!-- IMAGE URL -->

            <div class="mb-4">

                <label for="imageUrl" class="form-label">
                    Image URL
                </label>

                <input
                    name="listing[image][url]"
                    id="imageUrl"
                    type="url"
                    class="form-control"
                    placeholder="https://example.com/image.jpg"
                />

                <div class="form-text">
                    You can upload an image or paste an image URL.
                    If neither is provided, a default image will be used.
                </div>

            </div>


            <!-- PRICE + COUNTRY -->

            <div class="row">

                <div class="mb-4 col-md-4">

                    <label for="price" class="form-label">
                        Price
                    </label>

                    <input
                        name="listing[price]"
                        id="price"
                        placeholder="1200"
                        type="number"
                        class="form-control"
                        required
                    />

                    <div class="invalid-feedback">
                        Price should be valid
                    </div>

                </div>


                <div class="mb-4 col-md-8">

                    <label for="country" class="form-label">
                        Country
                    </label>

                    <input
                        name="listing[country]"
                        id="country"
                        placeholder="India"
                        type="text"
                        class="form-control"
                        required
                    />

                    <div class="invalid-feedback">
                        Country name should be valid
                    </div>

                </div>

            </div>


            <!-- LOCATION -->

            <div class="mb-4">

                <label for="location" class="form-label">
                    <i class="fa-solid fa-location-dot location-icon"></i>
                    Location
                </label>

                <input
                    name="listing[location]"
                    id="location"
                    placeholder="Jaipur, Rajasthan"
                    type="text"
                    class="form-control"
                    required
                />

                <div class="invalid-feedback">
                    Location name should be valid
                </div>

            </div>


            <!-- SUBMIT -->

            <div class="mt-4">

                <button
                    class="btn add-btn"
                    type="submit"
                >
                    <i class="fa-solid fa-plus me-2"></i>
                    Add Listing
                </button>

            </div>

        </form>

    </div>

</div>